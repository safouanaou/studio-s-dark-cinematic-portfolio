{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-s-enquiries",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "safouanaouezghar.com/api/enquiries", "zone_name": "safouanaouezghar.com" },
    { "pattern": "www.safouanaouezghar.com/api/enquiries", "zone_name": "safouanaouezghar.com" }
  ],
  "d1_databases": [
    {
      "binding": "ENQUIRIES_DB",
      "database_name": "studio-s-enquiries",
      "database_id": "d4ec1133-0034-4a44-88c3-9a403be538e7",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "aouezgharsafouan@gmail.com",
      "allowed_sender_addresses": ["hello@safouanaouezghar.com"]
    }
  ],
  "vars": {
    "FROM_EMAIL": "hello@safouanaouezghar.com",
    "NOTIFICATION_EMAIL": "aouezgharsafouan@gmail.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEPJzadzcHSZRlOX"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
